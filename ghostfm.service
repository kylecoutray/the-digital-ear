[Unit]
Description=GhostFM - The Digital Ear FM Synthesizer
After=network.target sound.target

[Service]
Type=simple
User=ghostfm
WorkingDirectory=/home/ghostfm/the-digital-ear
ExecStart=/home/ghostfm/the-digital-ear/venv/bin/python ghost_fm.py --display-backend fbdev --fbdev /dev/fb1 --display-width 480 --display-height 320 --no-joystick --no-synth --brightness 50
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
